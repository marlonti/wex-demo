@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject PurchasesStore Store

<PageTitle>Purchase Transactions</PageTitle>

<div class="d-flex align-items-center justify-content-between mb-4">
    <h1>Purchase Transactions</h1>
    <button class="btn btn-primary" @onclick="() => _newPurchaseDialog!.Show()">New Purchase</button>
</div>

<table class="table table-sm align-middle">
    <thead>
        <tr><th>Description</th><th>Transaction Date</th><th>Amount</th><th></th></tr>
    </thead>
    <tbody>
        @if (Store.Purchases.Count == 0)
        {
            <tr><td colspan="4" class="text-center text-muted">No purchases yet.</td></tr>
        }
        else
        {
            @foreach (var item in Store.Purchases)
            {
                <tr>
                    <td>@item.Description</td>
                    <td>@item.TransactionDate.ToString("yyyy-MM-dd")</td>
                    <td>@item.Amount.ToString("C")</td>
                    <td><a href="#" @onclick:preventDefault @onclick="() => _detailDialog!.Show(item.Id)">View Converted Currency</a></td>
                </tr>
            }
        }
    </tbody>
</table>

<NewPurchaseDialog @ref="_newPurchaseDialog" />
<PurchaseDetailDialog @ref="_detailDialog" />

@code {
    private NewPurchaseDialog? _newPurchaseDialog;
    private PurchaseDetailDialog? _detailDialog;

    protected override void OnInitialized() => Store.Changed += StateHasChanged;
    public void Dispose() => Store.Changed -= StateHasChanged;
}
